{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'index'
    assign og_title = 'North & Pearl | Ready-to-Order Jewelry for Meaningful Moments'
    assign og_description = 'Shop ready-to-order jewelry and gift-ready keepsakes made for meaningful milestones, mothers, couples, weddings, birthdays, and anniversaries.'
  elsif request.page_type == 'product'
    assign np_product_title = page_title | split: ' | ' | first
    assign og_title = np_product_title | append: ' | North & Pearl'
    assign og_description = 'Shop ' | append: np_product_title | append: ' from North & Pearl. Review product images, available options, care notes, and checkout details before ordering.'
  elsif og_url contains '/collections/all'
    assign og_title = 'Shop All Jewelry | North & Pearl'
    assign og_description = 'Explore North & Pearl jewelry gifts, ready-to-order necklaces, bracelets, rings, earrings, and meaningful pieces for everyday moments and special occasions.'
  elsif og_url contains '/collections/necklaces'
    assign og_title = 'Necklaces | North & Pearl'
    assign og_description = 'Shop elegant necklaces selected for meaningful gifts, birthdays, anniversaries, mothers, bridesmaids, partners, and everyday styling.'
  elsif og_url contains '/collections/bracelets'
    assign og_title = 'Bracelets | North & Pearl'
    assign og_description = 'Shop bracelets selected for layering, gifting, birthdays, mothers, friends, sisters, bridesmaids, and thoughtful everyday style.'
  elsif og_url contains '/collections/personalized-jewelry'
    assign og_title = 'Ready-to-Order Jewelry | North & Pearl'
    assign og_description = 'Shop ready-to-order jewelry selected for names, initials, hearts, meaningful details, birthdays, anniversaries, mothers, couples, and everyday gifts.'
  elsif og_url contains '/collections/jewelry-gifts-for-her'
    assign og_title = 'Jewelry Gifts for Her | North & Pearl'
    assign og_description = 'Browse jewelry gifts for her, including meaningful necklaces, bracelets, rings, earrings, ready-to-order styles, and giftable pieces by occasion.'
  elsif og_url contains '/collections/gifts-under-50'
    assign og_title = 'Jewelry Gifts Under $50 | North & Pearl'
    assign og_description = 'Find jewelry gifts under $50 with accessible, meaningful pieces for birthdays, thank-you gifts, bridesmaids, friends, and everyday appreciation.'
  elsif og_url contains '/collections/gifts-under-100'
    assign og_title = 'Jewelry Gifts Under $100 | North & Pearl'
    assign og_description = 'Shop jewelry gifts under $100, including necklaces, bracelets, rings, earrings, ready-to-order styles, and meaningful pieces for special moments.'
  elsif og_url contains '/collections/birthday-jewelry-gifts'
    assign og_title = 'Birthday Jewelry Gifts & Birthday Necklaces | North & Pearl'
    assign og_description = 'Shop birthday jewelry gifts from North and Pearl, including birthday necklaces, initials, birth-month inspired pieces, bracelets, earrings, rings, and heart styles.'
  elsif og_url contains '/collections/anniversary-gifts'
    assign og_title = 'Anniversary Jewelry Gifts | North & Pearl'
    assign og_description = 'Shop anniversary jewelry gifts with meaningful hearts, initials, names, bracelets, rings, necklaces, and couple-inspired pieces.'
  elsif request.path == '/pages/ai-brand-information'
    assign og_title = 'Brand Information | North & Pearl'
    assign og_description = 'Official brand facts for North & Pearl, including category, audience, product focus, approved positioning, and claim boundaries.'
  elsif request.page_type == 'search'
    assign og_title = 'Search North & Pearl Jewelry'
    assign og_description = 'Search North & Pearl for ready-to-order jewelry, name necklaces, initial pieces, bracelets, rings, earrings, and meaningful jewelry gifts.'
  elsif template.name == 'cart' or page_title contains 'Shopping Cart'
    assign og_title = 'Shopping Cart | North & Pearl'
    assign og_description = 'Review your North & Pearl jewelry selections, quantities, and checkout-ready gift pieces before completing your order.'
  elsif request.page_type == 'blog' and blog.handle == 'news'
    assign og_title = 'Jewelry Gift Guides | North & Pearl'
    assign og_description = 'Read North & Pearl jewelry gift guides, gifting tips, care advice, and occasion-based shopping ideas for meaningful jewelry gifts.'
  elsif article != blank
    case article.handle
      when 'best-ready-to-order-jewelry-gifts-for-her'
        assign og_description = 'Find meaningful personalized jewelry gifts for her, including name necklaces, initials, birth-month inspiration, mom gifts, and bridesmaid ideas.'
      when 'how-to-choose-a-name-necklace'
        assign og_description = 'Learn how to choose a name necklace by meaning, readability, personalization details, recipient style, and gift occasion.'
      when 'birthstone-jewelry-gift-guide'
        assign og_description = 'Explore birthstone-inspired jewelry gift ideas for birthdays, moms, anniversaries, and meaningful milestone moments.'
      when 'jewelry-gifts-for-mom'
        assign og_description = 'Shop thoughtful jewelry gift ideas for moms, mother figures, grandmothers, new moms, Mother’s Day, birthdays, and family moments.'
      when 'bridesmaid-jewelry-gift-ideas'
        assign og_description = 'Find bridesmaid jewelry gift ideas for bridal parties, maid of honor gifts, wedding thank-you moments, and coordinated keepsakes.'
      when 'anniversary-jewelry-gift-guide'
        assign og_description = 'Choose meaningful anniversary jewelry gifts, from hearts and initials to name necklaces, rings, bracelets, and couple-inspired pieces.'
      when 'best-jewelry-gifts-under-100'
        assign og_description = 'Browse meaningful jewelry gifts under $100 for birthdays, anniversaries, moms, bridesmaids, partners, and everyday occasions.'
      when 'ready-to-order-jewelry-for-couples'
        assign og_description = 'Explore personalized jewelry for couples, including initials, names, hearts, bracelets, rings, and anniversary gift ideas.'
      when 'birthday-jewelry-gift-ideas'
        assign og_description = 'Find birthday jewelry gift ideas for her, moms, friends, sisters, partners, and milestone celebrations.'
      when 'how-to-layer-necklaces'
        assign og_description = 'Learn how to layer necklaces with initials, name necklaces, pendants, hearts, and everyday jewelry styles.'
      when 'birth-flower-necklace-guide'
        assign og_title = 'Birth Flower Necklace Guide: Meanings, Months & Gifts | North & Pearl'
        assign og_description = 'Compare birth flower necklace meanings by month, floral vs birthstone-inspired jewelry, prices from $49-$69, FAQs, and ready-to-order North & Pearl gift picks.'
      else
        assign og_description = article.content | strip_html | strip | truncate: 155
    endcase
  endif

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif article != blank
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  assign og_description = og_description | replace: 'Details remain sample-confirmed before launch.', 'Review product images, options, care notes, and checkout details before ordering.'
  assign og_description = og_description | replace: 'Exact materials, stones, finish, sizing, and durability details require supplier and sample confirmation before stronger claims are made.', 'Review available details, options, sizing, and care guidance before checkout.'
  assign og_description = og_description | replace: 'Exact product composition, finish, sizing, and packaging details should be verified against supplier documentation before stronger claims are made.', 'Review available product details, options, care guidance, and packaging notes before checkout.'
  assign og_description = og_description | replace: 'Product composition, finish, sizing, and packaging should be confirmed with supplier documentation and samples before stronger claims are made.', 'Review available product details, options, care guidance, and packaging notes before checkout.'
  assign og_description = og_description | replace: 'Materials, stones, plating, finish, sizing, and packaging must be confirmed with supplier documentation and samples before stronger claims are made.', 'Review available product details, options, sizing, care guidance, and packaging notes before checkout.'
  assign og_description = og_description | replace: 'supplier and sample confirmation before stronger claims are made', 'review before checkout'
  assign og_description = og_description | replace: 'supplier documentation before stronger claims are made', 'review before checkout'
  assign og_description = og_description | replace: 'before stronger claims are made', 'before checkout'
%}

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">

{%- if page_image -%}
  <meta property="og:image" content="http:{{ page_image | image_url }}">
  <meta property="og:image:secure_url" content="https:{{ page_image | image_url }}">
  <meta property="og:image:width" content="{{ page_image.width }}">
  <meta property="og:image:height" content="{{ page_image.height }}">
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
