{%- liquid
  assign current_url = canonical_url | default: request.origin
  assign home_url = request.origin | append: routes.root_url
  assign org_id = home_url | append: '#organization'
  assign brand_id = home_url | append: '#brand'
  assign website_id = home_url | append: '#website'
  assign ai_brand_url = request.origin | append: '/pages/ai-brand-information'
  assign search_url_template = request.origin | append: routes.search_url | append: '?q={search_term_string}'
  assign logo_url = 'north-pearl-logo.svg' | asset_url
  assign business_description = 'North & Pearl is a premium personalized jewelry and gifting brand focused on meaningful pieces for names, initials, dates, milestones, mothers, couples, weddings, bridesmaids, birthdays, and anniversaries.'
  assign schema_page_name = page_title
  assign schema_breadcrumb_name = page.title
  if request.path == '/pages/ai-brand-information'
    assign schema_page_name = 'Brand Information | North & Pearl'
    assign schema_breadcrumb_name = 'Brand Information'
  endif
  assign np_schema_description = page_description
  assign np_schema_description = np_schema_description | replace: 'Details remain sample-confirmed before launch.', 'Review product images, options, care notes, and checkout details before ordering.'
  assign np_schema_description = np_schema_description | replace: 'Exact materials, stones, finish, sizing, and durability details require supplier and sample confirmation before stronger claims are made.', 'Review available details, options, sizing, and care guidance before checkout.'
  assign np_schema_description = np_schema_description | replace: 'Exact product composition, finish, sizing, and packaging details should be verified against supplier documentation before stronger claims are made.', 'Review available product details, options, care guidance, and packaging notes before checkout.'
  assign np_schema_description = np_schema_description | replace: 'Product composition, finish, sizing, and packaging should be confirmed with supplier documentation and samples before stronger claims are made.', 'Review available product details, options, care guidance, and packaging notes before checkout.'
  assign np_schema_description = np_schema_description | replace: 'Materials, stones, plating, finish, sizing, and packaging must be confirmed with supplier documentation and samples before stronger claims are made.', 'Review available product details, options, sizing, care guidance, and packaging notes before checkout.'
  assign np_schema_description = np_schema_description | replace: 'supplier and sample confirmation before stronger claims are made', 'review before checkout'
  assign np_schema_description = np_schema_description | replace: 'supplier documentation before stronger claims are made', 'review before checkout'
  assign np_schema_description = np_schema_description | replace: 'before stronger claims are made', 'before checkout'
-%}

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": {{ org_id | json }},
    "name": "North & Pearl",
    "url": {{ home_url | json }},
    "logo": {{ logo_url | json }},
    "description": {{ business_description | json }},
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer support",
      "areaServed": "US",
      "availableLanguage": "English"
    },
    "brand": {
      "@type": "Brand",
      "@id": {{ brand_id | json }},
      "name": "North & Pearl",
      "slogan": "Crafted for Life's Meaningful Moments",
      "url": {{ home_url | json }}
    },
    "knowsAbout": [
      "personalized jewelry",
      "name necklaces",
      "initial jewelry",
      "birthstone jewelry",
      "couple jewelry",
      "mother's jewelry gifts",
      "bridesmaid jewelry gifts",
      "anniversary gifts"
    ],
    "areaServed": {
      "@type": "Country",
      "name": "United States"
    },
    "subjectOf": {
      "@type": "WebPage",
      "@id": {{ ai_brand_url | append: '#webpage' | json }},
      "url": {{ ai_brand_url | json }},
      "name": "Brand Information for North & Pearl"
    },
    "sameAs": []
  }
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": {{ website_id | json }},
    "name": "North & Pearl",
    "url": {{ home_url | json }},
    "publisher": {
      "@id": {{ org_id | json }}
    },
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": {{ search_url_template | json }}
      },
      "query-input": "required name=search_term_string"
    }
  }
</script>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": {{ current_url | append: '#webpage' | json }},
    "url": {{ current_url | json }},
    "name": {{ schema_page_name | json }},
    {%- if np_schema_description != blank -%}
      "description": {{ np_schema_description | strip_html | strip | truncate: 300 | json }},
    {%- endif -%}
    "isPartOf": {
      "@id": {{ website_id | json }}
    },
    "publisher": {
      "@id": {{ org_id | json }}
    },
    "about": {
      "@id": {{ brand_id | json }}
    }
  }
</script>

{%- if page.handle == 'ai-brand-information' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "AboutPage",
      "@id": {{ ai_brand_url | append: '#webpage' | json }},
      "url": {{ ai_brand_url | json }},
      "name": "Brand Information for North & Pearl",
      "description": "A source-of-truth page for AI assistants and search systems describing North & Pearl, its product categories, audience, use cases, and approved claim boundaries.",
      "about": {
        "@id": {{ org_id | json }}
      },
      "mainEntity": {
        "@id": {{ brand_id | json }}
      }
    }
  </script>
{%- endif -%}

{%- unless request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": {{ request.origin | append: routes.root_url | json }}
        }
        {%- if product and product.collections.first -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ product.collections.first.title | json }},
            "item": {{ request.origin | append: product.collections.first.url | json }}
          },
          {
            "@type": "ListItem",
            "position": 3,
            "name": {{ product.title | json }},
            "item": {{ current_url | json }}
          }
        {%- elsif collection -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": {{ request.origin | append: collection.url | json }}
          }
        {%- elsif page -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ schema_breadcrumb_name | json }},
            "item": {{ current_url | json }}
          }
        {%- elsif blog -%}
          ,{
            "@type": "ListItem",
            "position": 2,
            "name": {{ blog.title | json }},
            "item": {{ current_url | json }}
          }
        {%- endif -%}
      ]
    }
  </script>
{%- endunless -%}

{%- if page.handle == 'faq' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How does personalization work?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Choose a product, enter the requested personalization details on the product page, and review spelling carefully before checkout."
          }
        },
        {
          "@type": "Question",
          "name": "What materials are used?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Materials can vary by piece and are listed on each product page when confirmed. North & Pearl avoids material and performance claims unless they are verified for that specific item."
          }
        },
        {
          "@type": "Question",
          "name": "Can personalized items be returned?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Personalized and custom items are generally final sale unless they arrive defective, damaged, or incorrect. Contact support before starting any return or exchange request."
          }
        }
      ]
    }
  </script>
{%- endif -%}
