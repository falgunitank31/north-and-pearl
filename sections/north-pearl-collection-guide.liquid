{{ 'north-pearl-collection-guide.css' | asset_url | stylesheet_tag }}

<section class="np-collection-guide color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="np-collection-guide__header">
      <p class="np-collection-guide__kicker">{{ section.settings.kicker }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.text }}</p>
    </div>

    <div class="np-collection-guide__chips" aria-label="Shop by shopping intent">
      <a href="{{ routes.collections_url }}/gifts">Gift-ready pieces</a>
      <a href="{{ routes.collections_url }}/personalized-jewelry">Personalized jewelry</a>
      <a href="{{ routes.collections_url }}/jewelry-gifts-for-her">Gifts for her</a>
      <a href="{{ routes.collections_url }}/gifts-under-50">Under $50</a>
      <a href="{{ routes.collections_url }}/gifts-under-100">Under $100</a>
      <a href="{{ routes.collections_url }}/name-necklaces">Names</a>
      <a href="{{ routes.collections_url }}/initial-necklaces">Initials</a>
      <a href="{{ routes.collections_url }}/birthstone-jewelry">Birth-month meaning</a>
      <a href="{{ routes.collections_url }}/birthday-jewelry-gifts">Birthday gifts</a>
      <a href="{{ routes.collections_url }}/anniversary-gifts">Anniversary gifts</a>
      <a href="{{ routes.collections_url }}/wedding-bridesmaids">Wedding gifts</a>
      <a href="{{ routes.root_url }}blogs/gift-guide/meaningful-jewelry-gifts-to-shop-this-week">Weekly gift guide</a>
    </div>

    <div class="np-collection-guide__chips np-collection-guide__chips--products" aria-label="Featured product paths">
      <a href="{{ routes.root_url }}products/north-pearl-heart-keepsake-necklace">Heart Keepsake Necklace</a>
      <a href="{{ routes.root_url }}products/north-pearl-initial-shell-necklace">Initial Shell Necklace</a>
      <a href="{{ routes.root_url }}products/north-pearl-personalized-nameplate-necklace">Personalized Nameplate Necklace</a>
      <a href="{{ routes.root_url }}products/north-pearl-flower-nail-bangle">Flower Nail Bangle</a>
      <a href="{{ routes.root_url }}products/north-pearl-sparkle-accent-bracelet">Sparkle Accent Bracelet</a>
    </div>

    <div class="np-collection-guide__grid">
      <article>
        <span>Personalization</span>
        <p>Choose a name, initial, date, charm, or symbolic detail that makes the piece feel specific to the recipient.</p>
      </article>
      <article>
        <span>Occasion</span>
        <p>Shop by birthday, anniversary, Mother's Day, wedding party, relationship milestone, or everyday meaning.</p>
      </article>
      <article>
        <span>Product details</span>
        <p>Review product-specific options, personalization fields, care notes, and policy links before checkout.</p>
      </article>
    </div>

    <div class="np-collection-guide__cta">
      <a class="button" href="{{ routes.collections_url }}/best-sellers">Start with best sellers</a>
      <a class="button button--secondary" href="{{ routes.collections_url }}/jewelry-gifts-for-her">Shop gifts for her</a>
      <a class="button button--secondary" href="{{ routes.root_url }}blogs/gift-guide/meaningful-jewelry-gifts-to-shop-this-week">Read the gift guide</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection shopping guide",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Shopping guide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the piece that carries the meaning."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Use collection filters, recipient ideas, and occasion links to move from inspiration to a personal, gift-ready piece."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "Collection shopping guide"
    }
  ]
}
{% endschema %}
