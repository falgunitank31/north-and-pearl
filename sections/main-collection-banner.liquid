{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'component-collection-hero.css' | asset_url | stylesheet_tag }}

{%- assign collection_hero_image = collection.image -%}

{%- style -%}
  @media screen and (max-width: 749px) {
    .collection-hero--with-image .collection-hero__inner {
      padding-bottom: calc({{ settings.media_shadow_vertical_offset | at_least: 0 }}px + 2rem);
    }
  }
{%- endstyle -%}

<div class="collection-hero{% if section.settings.show_collection_image and collection_hero_image %} collection-hero--with-image{% endif %} color-{{ section.settings.color_scheme }} gradient">
  <div class="collection-hero__inner page-width {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
    <div class="collection-hero__text-wrapper">
      <p class="np-collection-eyebrow">North & Pearl edit</p>
      <h1 class="collection-hero__title">
        <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
        {{- collection.title | escape -}}
      </h1>

      {%- if section.settings.show_collection_description -%}
        {%- assign collection_intro = collection.description | strip_html | strip | truncate: 115 -%}
        {%- if collection_intro != blank -%}
          <div class="collection-hero__description rte">
            <p>{{ collection_intro }}</p>
          </div>
        {%- endif -%}
      {%- endif -%}

      <div class="np-collection-meta" aria-label="Collection shopping details">
        <span>{{ collection.products_count }} pieces</span>
        <span>Gift-focused edit</span>
        <span>Secure checkout</span>
      </div>

      <nav class="np-collection-quicklinks" aria-label="Related jewelry collections">
        {%- assign quick_links = 'personalized-jewelry|Personalized Jewelry,jewelry-gifts-for-her|Gifts for Her,gifts-under-50|Under $50,gifts-under-100|Under $100,birthday-jewelry-gifts|Birthday Gifts,anniversary-gifts|Anniversary Gifts,best-sellers|Best Sellers,name-necklaces|Name Necklaces,initial-necklaces|Initials,gifts|Gifts' | split: ',' -%}
        {%- for quick_link in quick_links -%}
          {%- assign quick_parts = quick_link | split: '|' -%}
          {%- assign quick_collection = collections[quick_parts[0]] -%}
          {%- if quick_collection != blank and quick_collection.products_count > 0 and quick_collection.handle != collection.handle -%}
            <a href="{{ quick_collection.url }}">{{ quick_parts[1] }}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>

      <div class="np-collection-starter" aria-label="Fast shopping paths">
        <a href="{{ routes.collections_url }}/best-sellers">
          <span>Start fast</span>
          <strong>Featured Jewelry</strong>
        </a>
        <a href="{{ routes.collections_url }}/jewelry-gifts-for-her">
          <span>For gifting</span>
          <strong>Gifts for Her</strong>
        </a>
        <a href="{{ routes.collections_url }}/gifts-under-100">
          <span>Budget-friendly</span>
          <strong>Under $100</strong>
        </a>
        <a href="{{ routes.collections_url }}/birthday-jewelry-gifts">
          <span>Occasion edit</span>
          <strong>Birthday Gifts</strong>
        </a>
        <a href="{{ routes.collections_url }}/anniversary-gifts">
          <span>Meaningful picks</span>
          <strong>Anniversary Gifts</strong>
        </a>
      </div>

      {%- if collection.products_count > 0 -%}
        <div class="np-collection-product-jump" aria-label="Start with products in this collection">
          <p>Start with these pieces</p>
          <div>
            {%- assign np_product_jump_count = 0 -%}
            {%- for product in collection.products limit: 6 -%}
              {%- if product.available and product.featured_media and np_product_jump_count < 3 -%}
                {%- assign np_product_jump_count = np_product_jump_count | plus: 1 -%}
                <a href="{{ product.url }}">
                  <span class="np-collection-product-jump__image">
                    {{
                      product.featured_media
                      | image_url: width: 120
                      | image_tag:
                        widths: '80, 120',
                        sizes: '56px',
                        loading: 'lazy',
                        alt: product.featured_media.alt | default: product.title
                    }}
                  </span>
                  <span class="np-collection-product-jump__text">
                    <strong>{{ product.title | escape }}</strong>
                    <small>{{ product.price | money }}</small>
                  </span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.show_collection_image and collection_hero_image -%}
      <div class="collection-hero__image-container media gradient">
        {%- if collection.handle == 'birthstone-jewelry' -%}
          <img
            srcset="
              https://cdn.shopify.com/s/files/1/0969/9331/2952/files/He76ad48df8cd4935aa7e2439a008c145I.jpg?v=1784855788&width=165 165w,
              https://cdn.shopify.com/s/files/1/0969/9331/2952/files/He76ad48df8cd4935aa7e2439a008c145I.jpg?v=1784855788&width=360 360w,
              https://cdn.shopify.com/s/files/1/0969/9331/2952/files/He76ad48df8cd4935aa7e2439a008c145I.jpg?v=1784855788&width=535 535w,
              https://cdn.shopify.com/s/files/1/0969/9331/2952/files/He76ad48df8cd4935aa7e2439a008c145I.jpg?v=1784855788&width=750 750w,
              https://cdn.shopify.com/s/files/1/0969/9331/2952/files/He76ad48df8cd4935aa7e2439a008c145I.jpg?v=1784855788 800w
            "
            src="https://cdn.shopify.com/s/files/1/0969/9331/2952/files/He76ad48df8cd4935aa7e2439a008c145I.jpg?v=1784855788&width=750"
            sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
            alt="Birthstone-inspired pendant necklace curated by North & Pearl"
            width="800"
            height="800"
          >
        {%- else -%}
          <img
            srcset="
              {%- if collection_hero_image.width >= 165 -%}{{ collection_hero_image | image_url: width: 165 }} 165w,{%- endif -%}
              {%- if collection_hero_image.width >= 360 -%}{{ collection_hero_image | image_url: width: 360 }} 360w,{%- endif -%}
              {%- if collection_hero_image.width >= 535 -%}{{ collection_hero_image | image_url: width: 535 }} 535w,{%- endif -%}
              {%- if collection_hero_image.width >= 750 -%}{{ collection_hero_image | image_url: width: 750 }} 750w,{%- endif -%}
              {%- if collection_hero_image.width >= 1070 -%}{{ collection_hero_image | image_url: width: 1070 }} 1070w,{%- endif -%}
              {%- if collection_hero_image.width >= 1500 -%}{{ collection_hero_image | image_url: width: 1500 }} 1500w,{%- endif -%}
              {{ collection_hero_image | image_url }} {{ collection_hero_image.width }}w
            "
            src="{{ collection_hero_image | image_url: width: 750 }}"
            sizes="(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc(50vw - 130px), calc(50vw - 55px)"
            alt="{{ collection_hero_image.alt | default: collection.title | escape }}"
            width="{{ collection_hero_image.width }}"
            height="{{ collection_hero_image.height }}"
          >
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
