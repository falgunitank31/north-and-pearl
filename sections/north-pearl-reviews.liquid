{{ 'north-pearl-reviews.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign rating_value = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count | default: 0
  assign has_reviews = false

  if rating_value != blank and rating_count != blank and rating_count != 0
    assign has_reviews = true
  endif
-%}

<section class="np-reviews color-{{ section.settings.color_scheme }}" aria-labelledby="np-reviews-title-{{ section.id }}">
  <div class="page-width np-reviews__inner">
    <div class="np-reviews__copy">
      {%- if section.settings.kicker != blank -%}
        <p class="np-reviews__kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <h2 id="np-reviews-title-{{ section.id }}" class="np-reviews__title">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <p class="np-reviews__text">{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>

    <div class="np-reviews__panel">
      {%- if has_reviews -%}
        <div class="np-reviews__rating" aria-label="{{ product.title | escape }} customer rating">
          <span class="np-reviews__rating-value">
            {{ rating_value.rating | default: rating_value }} / {{ rating_value.scale_max | default: 5 }}
          </span>
          <span class="np-reviews__rating-count">
            {{ rating_count }} customer {%- if rating_count == 1 -%}review{%- else -%}reviews{%- endif -%}
          </span>
        </div>
        <p class="np-reviews__empty-text">
          Customer review details are managed through Shopify review metafields or an approved review app.
        </p>
      {%- else -%}
        <p class="np-reviews__empty-heading">{{ section.settings.empty_heading | escape }}</p>
        <p class="np-reviews__empty-text">{{ section.settings.empty_text | escape }}</p>
      {%- endif -%}

      <div class="np-reviews__checks" aria-label="North & Pearl review standards">
        <span>Real customer feedback only</span>
        <span>No invented ratings</span>
        <span>Questions welcome before ordering</span>
      </div>

      {%- if section.settings.contact_label != blank -%}
        <a class="np-reviews__link" href="{{ section.settings.contact_url }}">
          {{ section.settings.contact_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "North Pearl reviews",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Customer reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reviews will appear here as customers share feedback."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Intro text",
      "default": "North & Pearl only publishes real customer feedback. Until this piece has verified reviews, use the product details, images, and support links to choose with confidence."
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "Empty review heading",
      "default": "No published reviews yet"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Empty review text",
      "default": "This product is ready for real customer reviews, but we will not display star ratings or testimonials until feedback is actually collected."
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Contact link label",
      "default": "Ask a product question"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "Contact link URL"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "North Pearl reviews"
    }
  ]
}
{% endschema %}
